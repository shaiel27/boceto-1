{
  "expo": {
    "name": "tickets-app",
    "slug": "tickets-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "tickets-app",
    "splash": {
      "image": "./assets/icono.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a365d"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a365d"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#1a365d"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Sistema de gestion de tickets y solicitudes de servicio tecnico para la Alcaldia de San Cristobal",
    "web": {
      "name": "Sistema de Tickets — Alcaldia de San Cristobal",
      "shortName": "Tickets",
      "description": "Gestion de tickets y solicitudes de servicio tecnico",
      "lang": "es",
      "themeColor": "#1a365d",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "orientation": "portrait"
    }
  }
}
