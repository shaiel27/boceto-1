# URLs dinamicas: el frontend usa el mismo host que el navegador
# (API en puerto 8000, SSE eliminado)
# Dejar sin valor para resolucion automatica basada en window.location
# REACT_APP_API_BASE=http://localhost:8000

# Alternativa: URL terminada en /api
# REACT_APP_API_URL=http://192.168.2.4:8000/api

HOST=0.0.0.0
PORT=3000
REACT_APP_ENV=development
GENERATE_SOURCEMAP=false
