# Base del backend (sin /api). Si cambias de red, pon aquí tu IP o usa localhost.
REACT_APP_API_BASE=http://localhost:8000

# Alternativa: URL terminada en /api (solo si no usas REACT_APP_API_BASE)
# REACT_APP_API_URL=http://192.168.100.8:8000/api

# Development settings
REACT_APP_ENV=development
GENERATE_SOURCEMAP=false
