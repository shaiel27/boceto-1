# Copiar a .env en el servidor y cargar variables en el proceso PHP (no se usa automáticamente con php -S).
# En Apache: SetEnv DB_PASSWORD "..."
# En systemd (php-fpm): Environment=DB_PASSWORD=...

DB_HOST=localhost
DB_PORT=3306
DB_NAME=tickets_system
DB_USER=root
DB_PASSWORD=cambiar_en_produccion
